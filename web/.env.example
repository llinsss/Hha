# The web app is a pure frontend. It talks to the Houzz Hills API (../api).

# Recommended: the API's private address. The web server forwards /api/v1/* to it,
# so the browser uses one origin (first-party cookies, no CORS). Read at BUILD time.
# Local development: http://localhost:4000
API_INTERNAL_URL=http://localhost:4000

# Alternative: call the API directly from the browser on another origin.
# Leave empty when API_INTERNAL_URL is set. Inlined at build time.
NEXT_PUBLIC_API_BASE_URL=

# Link back to the public marketing website.
NEXT_PUBLIC_WEBSITE_URL=https://houzzhills.com
