# The web app is a pure frontend: no database, no secrets, no API routes.
# Only NEXT_PUBLIC_* values belong here (they are embedded in the browser bundle).

# Houzz Hills API origin (the ../api service), e.g. http://localhost:4000.
# Leave EMPTY to run on built-in sample data with no network requests.
# Only set it once the endpoints used in src/lib/api/http.ts exist in the API.
NEXT_PUBLIC_API_BASE_URL=

# Link back to the public marketing website.
NEXT_PUBLIC_WEBSITE_URL=https://houzzhills.com
