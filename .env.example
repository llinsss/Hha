DATABASE_URL=postgresql://houzzhills:replace-this@localhost:5432/houzzhills
DATABASE_SSL=false
APP_URL=https://houzzhills.com
# Leave empty while the management UI and API share one origin. Set to the API origin after extraction.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_WEBSITE_URL=https://houzzhills.com
# Generate a long random value, e.g. `openssl rand -base64 48`
SETUP_SECRET=replace-with-a-long-random-value
# Set one provider and its server-side secret. Use test credentials until go-live approval.
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_test_replace_me
# For Flutterwave, select PAYMENT_PROVIDER=flutterwave and set both values below.
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-replace_me
FLUTTERWAVE_WEBHOOK_HASH=replace-with-the-webhook-secret-hash-from-flutterwave
# A scheduled POST to /api/cron/expire-payment-holds should send Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=replace-with-a-long-random-value
