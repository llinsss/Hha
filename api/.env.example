# Copy to .env for local development. Every variable is validated at boot
# (src/config/env.ts); the process refuses to start on invalid configuration.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# Reverse-proxy hops to trust for client IPs (1 behind a single load balancer).
TRUST_PROXY_HOPS=0
API_PREFIX=/api/v1
# Exact browser origins allowed to call the API with credentials (comma-separated).
CORS_ORIGINS=http://localhost:3000
# OpenAPI at /openapi.json and Swagger UI at /docs. Defaults to off in production.
DOCS_ENABLED=true

DATABASE_URL=postgresql://houzzhills:houzzhills@127.0.0.1:5432/houzzhills
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOGGING=false

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=hh:

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-output-of-openssl-rand-base64-48
JWT_ISSUER=houzzhills-api
JWT_AUDIENCE=houzzhills-web
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Refresh-token cookie. Set COOKIE_DOMAIN=.houzzhills.com when web and API are on sibling subdomains.
COOKIE_DOMAIN=
# Must be true in production. Browsers accept Secure cookies on http://localhost.
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
LOGIN_MAX_FAILURES=7
LOGIN_LOCKOUT_SECONDS=900

BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
KEEP_ALIVE_TIMEOUT_MS=72000
SHUTDOWN_GRACE_MS=10000
# Public booking attempts per client IP per minute.
PUBLIC_BOOKING_RATE_LIMIT_MAX=10

# ---- Online payments ----
# The provider (Paystack or Flutterwave), its secret keys and the booking rules are
# owner-managed global settings (Settings page / /api/v1/management/settings),
# encrypted at rest with this key. 32 bytes, base64: openssl rand -base64 32
# Keep it stable: changing it makes saved provider keys unreadable (re-enter them).
SETTINGS_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32
# Web origin guests return to after checkout: ${PUBLIC_WEB_URL}/payment-result?reference=...
# Also gives the webhook URL shown in Settings: ${PUBLIC_WEB_URL}/api/v1/webhooks/payments
PUBLIC_WEB_URL=http://localhost:3000
# Provider API endpoints (override only for testing).
PAYSTACK_BASE_URL=https://api.paystack.co
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
PROVIDER_TIMEOUT_MS=12000

# ---- Operations ----
# Bearer secret for POST /api/v1/cron/* (32+ chars), for external schedulers. Unneeded when
# jobs run as `node dist/scripts/run-job.js <job>` (Railway cron). Jobs reject calls when unset.
CRON_SECRET=
RECONCILIATION_WINDOW_HOURS=48
# One-time owner bootstrap secret, sent as x-setup-secret (32+ chars). Remove after setup.
SETUP_SECRET=
# Bearer token for GET /metrics (32+ chars). /metrics is not exposed when unset.
METRICS_TOKEN=
