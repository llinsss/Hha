{
  "name": "houzzhills-api",
  "version": "0.1.0",
  "private": true,
  "description": "Houzz Hills backend API (Fastify + TypeORM + PostgreSQL + Redis)",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/scripts/migrate.ts up",
    "db:migrate:revert": "node --env-file-if-exists=.env --import tsx src/scripts/migrate.ts down",
    "db:migrate:status": "node --env-file-if-exists=.env --import tsx src/scripts/migrate.ts status",
    "db:migrate:prod": "node --enable-source-maps dist/scripts/migrate.js up",
    "db:migration:create": "node --import tsx ./node_modules/typeorm/cli.js migration:create"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.6",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/under-pressure": "^9.2.0",
    "close-with-grace": "^2.5.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "secure-json-parse": "^4.1.0",
    "typebox": "^1.3.35",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
